# XRules — copy to .env and edit
#
#   cp .env.example .env
#   docker compose -f docker-compose.production.yml up -d

# ---- Required (no defaults; the stack refuses to start without these) ----
# Generate with:  openssl rand -hex 32
JWT_SECRET=replace-with-a-fresh-32-byte-random-secret
CONNECTION_ENC_KEY=replace-with-another-32-byte-random-secret

# ---- Postgres (defaults are safe for local dev) ----
POSTGRES_USER=xrules
POSTGRES_PASSWORD=xrules_secret
POSTGRES_DB=xrulesdb

# ---- LLM providers (optional; enables AI Agent rule type) ----
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# ---- Webhook dispatcher ----
WEBHOOK_DELIVERY_TIMEOUT_MS=10000

# ---- Public-facing URLs (only edit if exposed via reverse proxy) ----
# PUBLIC_APP_URL=https://xrules.example.com
# PUBLIC_BACKEND_URL=https://api.xrules.example.com

# ---- Ports (host-side; container always listens on canonical ports) ----
# STUDIO_PORT=3000
# BACKEND_PORT=4000

# ---- Engine logging ----
# RUST_LOG=info
