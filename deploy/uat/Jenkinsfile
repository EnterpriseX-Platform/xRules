// xRules → NEB UAT. Job: BB_UAT/xrules. One run = build + push + deploy (api and/or web).
pipeline {
    agent any
    environment {
        GIT_REPO = 'http://10.1.102.69/bb/support/neb-xrules.git'   // job config injects credentials into this URL
        DOCKER_CREDENTIALS_ID = 'nipa-repo-image'
    }
    parameters {
        string(name: 'DOCKER_IMAGE_NAME', defaultValue: 'registry.nipa.cloud/ebudet-bb-registry/neb-page', description: 'Image repository')
        string(name: 'VERSION', defaultValue: "v1.${new Date().format('yyyyMMdd.HHmm', TimeZone.getTimeZone('GMT+7'))}", description: 'Tag suffix; images become xrules-api.<VERSION> / xrules-web.<VERSION>')
        choice(name: 'COMPONENT', choices: ['both', 'api', 'web'], description: 'What to build and deploy')
        choice(name: 'KUBE_NAMESPACE', choices: ['budget-bb'], description: '')
        choice(name: 'KUBECONFIG_CREDENTIAL_ID', choices: ['k8s-user-on-uat'], description: '')
        string(name: 'GIT_REF', defaultValue: 'master', description: 'Branch, tag or commit')
    }
    stages {
        stage('Clone') {
            steps { dir('xrules') { git branch: params.GIT_REF ?: 'master', url: env.GIT_REPO } }
        }
        stage('Build & push') {
            steps {
                script {
                    def parts = params.COMPONENT == 'both' ? ['api', 'web'] : [params.COMPONENT]
                    dir('xrules') {
                        docker.withRegistry('https://registry.nipa.cloud', env.DOCKER_CREDENTIALS_ID) {
                            parts.each { p ->
                                def img = "${params.DOCKER_IMAGE_NAME}:xrules-${p}.${params.VERSION}"
                                sh "docker build --platform=linux/amd64 -f deploy/uat/${p}.Dockerfile -t ${img} ."
                                sh "docker push ${img}"
                                sh "docker rmi ${img} || true"
                            }
                        }
                    }
                }
            }
        }
        stage('Deploy') {
            steps {
                script {
                    def parts = params.COMPONENT == 'both' ? ['api', 'web'] : [params.COMPONENT]
                    withCredentials([file(credentialsId: params.KUBECONFIG_CREDENTIAL_ID, variable: 'KUBECONFIG')]) {
                        parts.each { p ->
                            sh "kubectl -n ${params.KUBE_NAMESPACE} set image deployment/xrules-${p} xrules-${p}=${params.DOCKER_IMAGE_NAME}:xrules-${p}.${params.VERSION}"
                            sh "kubectl -n ${params.KUBE_NAMESPACE} rollout status deployment/xrules-${p} --timeout=300s"
                        }
                        sh "kubectl -n ${params.KUBE_NAMESPACE} get pods -l 'app in (xrules-api,xrules-web)' -o wide"
                    }
                }
            }
        }
    }
}
