<?xml version="1.0" encoding="UTF-8"?>
<PMML version="4.4" xmlns="http://www.dmg.org/PMML-4_4">
  <Header copyright="XRules PMML Engine" description="Sample Linear Regression Model">
    <Application name="XRules" version="0.1.0"/>
    <Timestamp>2024-01-15T10:30:00Z</Timestamp>
  </Header>
  
  <DataDictionary numberOfFields="4">
    <DataField name="age" optype="continuous" dataType="double"/>
    <DataField name="income" optype="continuous" dataType="double"/>
    <DataField name="credit_score" optype="continuous" dataType="double"/>
    <DataField name="approval_probability" optype="continuous" dataType="double"/>
  </DataDictionary>
  
  <RegressionModel modelName="LoanApprovalRegression" functionName="regression" algorithmName="linearRegression" targetFieldName="approval_probability">
    <MiningSchema>
      <MiningField name="age" usageType="active"/>
      <MiningField name="income" usageType="active"/>
      <MiningField name="credit_score" usageType="active"/>
      <MiningField name="approval_probability" usageType="target"/>
    </MiningSchema>
    
    <RegressionTable intercept="0.1">
      <NumericPredictor name="age" coefficient="0.005"/>
      <NumericPredictor name="income" coefficient="0.00001"/>
      <NumericPredictor name="credit_score" coefficient="0.001"/>
    </RegressionTable>
  </RegressionModel>
