# XRules Engine Configuration

# Server Configuration
ENGINE_HOST=0.0.0.0
ENGINE_PORT=50051
ENGINE_WORKER_THREADS=8
ENGINE_MAX_CONCURRENT_EXECUTIONS=100

# gRPC Configuration
GRPC_MAX_MESSAGE_SIZE=16777216
GRPC_KEEPALIVE_TIMEOUT=20

# Database Configuration
DATABASE_URL=postgres://postgres:postgres@localhost:5432/xrules
DATABASE_MAX_CONNECTIONS=20
DATABASE_MIN_CONNECTIONS=5
DATABASE_CONNECT_TIMEOUT=10

# Redis Configuration
REDIS_URL=redis://localhost:6379
REDIS_POOL_SIZE=10
REDIS_TIMEOUT=5

# Kafka Configuration
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC_EXECUTIONS=xrules-executions
KAFKA_TOPIC_LOGS=xrules-logs
KAFKA_GROUP_ID=xrules-engine
KAFKA_SECURITY_PROTOCOL=PLAINTEXT

# Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=json
LOG_FILE_PATH=/var/log/xrules/engine.log

# Execution Configuration
EXECUTION_TIMEOUT_SECONDS=300
EXECUTION_MAX_RETRY_ATTEMPTS=3
EXECUTION_RETRY_DELAY_SECONDS=5
EXECUTION_DEAD_LETTER_QUEUE=true

# Metrics Configuration
METRICS_ENABLED=true
METRICS_PORT=9090
METRICS_ENDPOINT=/metrics

# Security Configuration
ENCRYPTION_KEY=your-32-byte-encryption-key-here!!
HMAC_SECRET=your-hmac-secret-key-for-signing
API_KEY_VALIDATION=true

# Feature Flags
ENABLE_STREAMING=true
ENABLE_SCHEDULING=true
ENABLE_CACHING=true
ENABLE_METRICS=true
